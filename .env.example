# Copiar a .env y ajustar. Nunca commitear .env real.

# --- API ---
APP_NAME=AulaVirtual
ENVIRONMENT=development
API_PREFIX=/api/v1
DEBUG=true

# Seguridad (obligatorio en producción; mínimo 32 chars)
SECRET_KEY=change-me-to-a-long-random-string-32+
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Orígenes CORS separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://aula:aula@localhost:5432/aula
# Tests locales (SQLite) / CI puede sobreescribir con PG:
TESTING_DATABASE_URL=sqlite:///./test.db

# --- Almacenamiento ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Archivos ---
MAX_UPLOAD_MB=10

# --- Stripe (Fase B) ---
# Solo claves TEST en desarrollo (sk_test_... / whsec_... de `stripe listen`).
# En producción son OBLIGATORIOS y distintos de estos placeholders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Un Price de Stripe por plan (catálogo de /api/v1/public/plans)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_CAMPUS=

# --- Email transaccional (Resend, Fase B) ---
# Vacío en desarrollo: el email de activación se escribe en el log.
# En producción es OBLIGATORIO (modo test: remitente onboarding@resend.dev).
RESEND_API_KEY=
EMAIL_FROM="Aspasia <onboarding@resend.dev>"
# Base pública (enlaces de activación y URLs del Checkout)
PUBLIC_BASE_URL=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
