# Copiar a .env y ajustar. Nunca commitear .env real.

# --- API ---
APP_NAME=AulaVirtual
ENVIRONMENT=development
API_PREFIX=/api/v1
DEBUG=true

# Seguridad (obligatorio en producción; mínimo 32 chars)
SECRET_KEY=change-me-to-a-long-random-string-32+
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Orígenes CORS separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://aula:aula@localhost:5432/aula
# Tests locales (SQLite) / CI puede sobreescribir con PG:
TESTING_DATABASE_URL=sqlite:///./test.db

# --- Almacenamiento ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Archivos ---
MAX_UPLOAD_MB=10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
